# ==========================================
# Application
# ==========================================

ENVIRONMENT=development
DEBUG=true


# ==========================================
# LLM
# ==========================================
# LLM Token Settings
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Gemini specific
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=4096

# OpenAI specific
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
# Add your actual API key only to .env
# Never commit .env to Git


# ==========================================
# Embeddings
# ==========================================

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ==========================================
# Retrieval
# ==========================================

BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

TOP_K_RETRIEVAL=20
TOP_K_RERANKING=5


# ==========================================
# Verification
# ==========================================

NUMERICAL_TOLERANCE=0.01
MINIMUM_VERIFICATION_SCORE=0.90


# ==========================================
# Risk
# ==========================================

LOW_RISK_THRESHOLD=0.90
MEDIUM_RISK_THRESHOLD=0.70


# ==========================================
# Database
# ==========================================

DATABASE_URL=sqlite:///./data/audit.db


# ==========================================
# API
# ==========================================

API_HOST=127.0.0.1
API_PORT=8000

# ==========================================
# Company Support
# ==========================================

# Available companies in your document database
COMPANIES=Apple,Microsoft,Google,Amazon,Real Brokerage

# Default company if not specified
DEFAULT_COMPANY=Apple
# ==========================================
# Financial Extraction Settings
# ==========================================

# Minimum value threshold (0 = no filtering)
# Set to 0 to extract all values regardless of size
MIN_VALUE_THRESHOLD=0
