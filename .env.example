# ==========================================
# Retrieval Confidence
# ==========================================
# RRF scores are naturally small (~0.01-0.03)
# Set threshold accordingly
MIN_RETRIEVAL_CONFIDENCE=0.01
MIN_OVERALL_CONFIDENCE=0.70
MIN_EVIDENCE_CHUNKS=1

# ==========================================
# Risk Thresholds
# ==========================================
MAX_RISK_SCORE=0.7
RISK_LOW_THRESHOLD=0.2
RISK_MEDIUM_THRESHOLD=0.5
RISK_HIGH_THRESHOLD=0.8

# ==========================================
# Guardrail Behavior
# ==========================================
BLOCK_ON_NUMERIC_MISMATCH=False
ALLOW_UNSUPPORTED_CLAIMS=False
INCLUDE_DISCLAIMER_ON_LOW_CONFIDENCE=True

# ==========================================
# Risk Increments (fine-tune as needed)
# ==========================================
RISK_INCREMENT_REJECTED=0.5
RISK_INCREMENT_INCONCLUSIVE=0.1
RISK_INCREMENT_CONTRADICTION=0.3
RISK_INCREMENT_LOW_CONFIDENCE=0.6
RISK_INCREMENT_MISSING_PROVENANCE=0.8
RISK_INCREMENT_NO_EVIDENCE=0.8
RISK_INCREMENT_INSUFFICIENT_EVIDENCE=0.2
RISK_INCREMENT_NUMERIC_MISMATCH=0.4

# ==========================================
# RRF Configuration
# ==========================================
RRF_K=60